<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.StrikeZone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A2A52</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DCE4FF</item>
        <item name="colorOnPrimaryContainer">#0A1128</item>
        <item name="colorSecondary">#1F7A35</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#C9F2D2</item>
        <item name="colorOnSecondaryContainer">#062B12</item>
        <item name="colorTertiary">#8A6D00</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFE58F</item>
        <item name="colorOnTertiaryContainer">#2B2100</item>
        <item name="colorError">#BA1A2A</item>
        <item name="android:colorBackground">#F4F6FB</item>
        <item name="colorOnBackground">#0A1128</item>
        <item name="colorSurface">#F4F6FB</item>
        <item name="colorOnSurface">#0A1128</item>
        <item name="colorSurfaceVariant">#E1E6F2</item>
        <item name="colorOnSurfaceVariant">#4A5572</item>
        <item name="colorOutline">#8790A8</item>
        <item name="colorOutlineVariant">#CBD2E1</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainer">#EEF1F8</item>
        <item name="colorSurfaceContainerHigh">#E8ECF5</item>
        <item name="colorSurfaceContainerHighest">#E1E6F2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialCardViewStyle">@style/Widget.StrikeZone.Card</item>
        <item name="toolbarStyle">@style/Widget.StrikeZone.Toolbar</item>
    </style>

    <style name="Theme.StrikeZone" parent="Base.Theme.StrikeZone" />

    <style name="Theme.StrikeZone.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StrikeZone</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.StrikeZone.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_m</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.StrikeZone.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="navigationIcon">@drawable/ic_back</item>
        <item name="titleTextAppearance">@style/TextAppearance.StrikeZone.ToolbarTitle</item>
    </style>

    <style name="Widget.StrikeZone.Button.Floodlight" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/floodlight_yellow</item>
        <item name="android:textColor">@color/night_900</item>
        <item name="iconTint">@color/night_900</item>
        <item name="android:textAppearance">@style/TextAppearance.StrikeZone.Button</item>
        <item name="android:minHeight">60dp</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="Widget.StrikeZone.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.StrikeZone.Button</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.StrikeZone.HomeTile" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_m</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="HomeTileText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">20dp</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="drawableTint">?attr/colorPrimary</item>
    </style>

    <style name="SetupSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textAppearance">@style/TextAppearance.StrikeZone.Section</item>
    </style>

    <style name="DirectionLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_direction</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:alpha">0.7</item>
    </style>

    <style name="SummaryStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.StrikeZone.StatValue</item>
    </style>

    <style name="SummaryStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SummaryStatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HowToBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.StrikeZone.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StrikeZone.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.StrikeZone.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StrikeZone.Score" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StrikeZone.HudLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/white_70</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.StrikeZone.HudValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StrikeZone.Chip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.StrikeZone.StatValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
