<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- Hero: animated stadium with title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="380dp">

            <io.github.ieswar23.strikezone.ui.common.FloodlightView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/heroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:paddingBottom="56dp">

                <ImageView
                    android:id="@+id/titleBall"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="@dimen/space_xl"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cricket_ball" />

                <TextView
                    android:id="@+id/titleTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="@string/home_title_top"
                    android:textColor="@color/floodlight_yellow"
                    android:textSize="44sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/titleBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.6"
                    android:text="@string/home_title_bottom"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/home_tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/white_70" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playButton"
                    style="@style/Widget.StrikeZone.Button.Floodlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="@string/home_play"
                    app:icon="@drawable/ic_play" />
            </LinearLayout>
        </FrameLayout>

        <!-- Quick stats strip overlapping the hero -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="-36dp"
            android:layout_marginEnd="@dimen/space_xl"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="@dimen/space_l">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quickPlayed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textAppearance="@style/TextAppearance.StrikeZone.StatValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_played"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quickWins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textAppearance="@style/TextAppearance.StrikeZone.StatValue"
                        android:textColor="?attr/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_won"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quickBest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textAppearance="@style/TextAppearance.StrikeZone.StatValue"
                        android:textColor="?attr/colorTertiary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_best"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily challenge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_daily_section"
                android:textAppearance="@style/TextAppearance.StrikeZone.Section" />

            <TextView
                android:id="@+id/challengeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/challengeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_l"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/night_800"
            app:cardCornerRadius="@dimen/corner_l"
            app:strokeColor="#55FFD23F"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:id="@+id/challengeSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="180dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="@dimen/space_m"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="240dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="@dimen/space_s"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/space_l"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/challengeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_challenge_error"
                        android:textColor="@color/white_70" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/challengeRetry"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_retry"
                        android:textColor="@color/floodlight_yellow"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/floodlight_yellow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/challengeBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/challengeBadge"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_pill"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/challengeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/white"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/challengeTarget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="@color/floodlight_yellow" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/challengeDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:drawablePadding="@dimen/space_xs"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/space_s"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_s"
                            android:paddingBottom="@dimen/space_xs"
                            android:text="@string/home_challenge_done"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/grass_green"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_check_circle"
                            app:drawableTint="@color/grass_green" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/challengeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/white_70" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/challengePlay"
                        style="@style/Widget.StrikeZone.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/home_challenge_play"
                        android:textColor="@color/night_900"
                        app:backgroundTint="@color/grass_green"
                        app:icon="@drawable/ic_bolt"
                        app:iconTint="@color/night_900" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation tiles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/home_more_section"
            android:textAppearance="@style/TextAppearance.StrikeZone.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHistory"
                style="@style/Widget.StrikeZone.HomeTile"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/HomeTileText"
                    android:text="@string/home_tile_history"
                    app:drawableTopCompat="@drawable/ic_history" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileStats"
                style="@style/Widget.StrikeZone.HomeTile"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/HomeTileText"
                    android:text="@string/home_tile_stats"
                    app:drawableTopCompat="@drawable/ic_stats" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileHowTo"
                style="@style/Widget.StrikeZone.HomeTile"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/HomeTileText"
                    android:text="@string/home_tile_howto"
                    app:drawableTopCompat="@drawable/ic_help" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileSettings"
                style="@style/Widget.StrikeZone.HomeTile"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/HomeTileText"
                    android:text="@string/home_tile_settings"
                    app:drawableTopCompat="@drawable/ic_tune" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileAchievements"
            style="@style/Widget.StrikeZone.HomeTile"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_l"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HomeTileText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/home_tile_achievements"
                    app:drawableStartCompat="@drawable/ic_trophy" />

                <TextView
                    android:id="@+id/achievementsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:textAppearance="@style/TextAppearance.StrikeZone.StatValue"
                    android:textColor="?attr/colorTertiary"
                    android:textSize="22sp"
                    tools:text="5/12" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
