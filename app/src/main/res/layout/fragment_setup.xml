<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/action_back"
            app:title="@string/setup_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s">

            <!-- Mode -->
            <TextView
                style="@style/SetupSectionLabel"
                android:text="@string/setup_mode" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginEnd="@dimen/space_l"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeQuick"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_quick"
                    app:icon="@drawable/ic_bolt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeDaily"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_daily"
                    app:icon="@drawable/ic_calendar" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/challengeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginEnd="@dimen/space_l"
                android:visibility="gone"
                app:cardBackgroundColor="@color/night_800"
                app:strokeColor="#55FFD23F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:id="@+id/challengeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/floodlight_yellow"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/challengeDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/white_70" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/setup_challenge_locked"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/white_50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Teams -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SetupSectionLabel"
                        android:text="@string/setup_your_team" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/teamList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:minHeight="140dp"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m" />

                    <TextView
                        style="@style/SetupSectionLabel"
                        android:text="@string/setup_opponent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/opponentList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:minHeight="140dp"
                        android:paddingStart="@dimen/space_m"
                        android:paddingEnd="@dimen/space_m" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loadingGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/setup_loading_teams"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/errorGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retryButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/action_retry"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>
            </FrameLayout>

            <!-- Overs -->
            <TextView
                style="@style/SetupSectionLabel"
                android:text="@string/setup_overs" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/oversGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginEnd="@dimen/space_l"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/overs1"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="1"
                    android:text="@string/setup_overs_1" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/overs2"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="2"
                    android:text="@string/setup_overs_2" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/overs5"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="5"
                    android:text="@string/setup_overs_5" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Difficulty -->
            <TextView
                style="@style/SetupSectionLabel"
                android:text="@string/setup_difficulty" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/difficultyToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginEnd="@dimen/space_l"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/difficultyEasy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/difficulty_easy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/difficultyMedium"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/difficulty_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/difficultyHard"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/difficulty_hard" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/space_l"
                app:cardCornerRadius="@dimen/corner_l"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_night_gradient"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/summaryMatchup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/summaryDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/white_70" />

                        <TextView
                            android:id="@+id/summaryRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/white_70" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rerollButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-12dp"
                            android:text="@string/setup_reroll"
                            android:textColor="@color/floodlight_yellow"
                            app:icon="@drawable/ic_refresh"
                            app:iconTint="@color/floodlight_yellow" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_target_label"
                            android:textAppearance="@style/TextAppearance.StrikeZone.HudLabel" />

                        <TextView
                            android:id="@+id/summaryTarget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.StrikeZone.Score"
                            android:textColor="@color/floodlight_yellow" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainerLow"
        android:elevation="8dp"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            style="@style/Widget.StrikeZone.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_start"
            app:icon="@drawable/ic_play" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
