<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_l">

        <!-- Result hero -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m"
            android:background="@drawable/bg_hud"
            android:padding="@dimen/space_l">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/summary_close"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trophy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/resultHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:textSize="38sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/battingBadge"
                            android:layout_width="@dimen/badge_m"
                            android:layout_height="@dimen/badge_m"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/battingName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/white_70" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/finalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textAppearance="@style/TextAppearance.StrikeZone.Score"
                            android:textColor="@color/floodlight_yellow"
                            android:textSize="44sp" />

                        <TextView
                            android:id="@+id/finalOvers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/white_70" />

                        <TextView
                            android:id="@+id/targetText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/floodlight_yellow" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bowlingBadge"
                            android:layout_width="@dimen/badge_m"
                            android:layout_height="@dimen/badge_m"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bowlingName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/white_70" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/white_50" />
            </LinearLayout>
        </FrameLayout>

        <!-- Badges this match unlocked (hidden when there are none) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/night_800"
            app:cardCornerRadius="@dimen/corner_m"
            app:strokeColor="@color/floodlight_yellow"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_night_gradient"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeBannerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/floodlight_yellow"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_trophy"
                        app:drawableTint="@color/floodlight_yellow" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_badge_view_all"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/white_70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/badgeBannerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Batting card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/summary_batting_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statRuns"
                            style="@style/SummaryStatValue" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_runs" />
                    </LinearLayout>

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statBalls"
                            style="@style/SummaryStatValue" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_balls" />
                    </LinearLayout>

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statStrikeRate"
                            style="@style/SummaryStatValue"
                            android:textColor="?attr/colorTertiary" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_strike_rate" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statFours"
                            style="@style/SummaryStatValue"
                            android:textColor="?attr/colorSecondary" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_fours" />
                    </LinearLayout>

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statSixes"
                            style="@style/SummaryStatValue"
                            android:textColor="?attr/colorTertiary" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_sixes" />
                    </LinearLayout>

                    <LinearLayout style="@style/SummaryStatCell">

                        <TextView
                            android:id="@+id/statDots"
                            style="@style/SummaryStatValue" />

                        <TextView
                            style="@style/SummaryStatLabel"
                            android:text="@string/summary_dots" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/extrasText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Manhattan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/summary_chart_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_chart_legend"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <io.github.ieswar23.strikezone.ui.common.ManhattanChartView
                    android:id="@+id/manhattan"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/space_s" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/summary_home"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playAgainButton"
                style="@style/Widget.StrikeZone.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/summary_play_again"
                app:icon="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
