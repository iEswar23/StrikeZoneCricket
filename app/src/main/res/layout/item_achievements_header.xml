<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="@dimen/corner_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_night_gradient"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/unlockRing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:max="100"
                app:indicatorColor="@color/floodlight_yellow"
                app:indicatorSize="96dp"
                app:trackColor="@color/white_12"
                app:trackCornerRadius="6dp"
                app:trackThickness="9dp" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_trophy"
                app:tint="@color/floodlight_yellow" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/achievements_header_label"
                android:textAppearance="@style/TextAppearance.StrikeZone.HudLabel" />

            <TextView
                android:id="@+id/unlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="5 / 12 unlocked" />

            <TextView
                android:id="@+id/nextUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/white_70"
                tools:text="Next up: Chase Master · 4/5" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
