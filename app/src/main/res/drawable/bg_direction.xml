<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#33FFD23F" />
            <corners android:radius="100dp" />
            <stroke android:width="1.5dp" android:color="@color/floodlight_yellow" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/hud_scrim" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="@color/white_12" />
        </shape>
    </item>
</selector>
